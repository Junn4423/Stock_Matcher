# Có thể để trống và nhập API key trực tiếp trên giao diện.
PEXELS_API_KEY=
HOST=127.0.0.1
PORT=8765
MAX_UPLOAD_MB=20
MAX_SEGMENTS=300
CACHE_TTL_HOURS=168
REQUEST_TIMEOUT_SECONDS=30
MAX_API_RETRIES=4
DEFAULT_RESULTS_PER_QUERY=18
DEFAULT_MAX_QUERIES_PER_SEGMENT=2
JOB_WORKERS=2
# rules = thuật toán cục bộ, không tốn phí và không cần model ngoài.
QUERY_PROVIDER=rules
